# Copy to .env.local and fill in. Restart `npm run dev` after changes.

# --- Settings (in production: set by cloudbuild.yaml) ---

# Origin the app is served from; each OAuth callback is this + /api/auth/callback/<provider>
NEXTAUTH_URL=http://localhost:3000

# Firestore project; for credentials set GOOGLE_APPLICATION_CREDENTIALS or run `gcloud auth application-default login`
GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Google OAuth client (https://console.cloud.google.com/apis/credentials), type "Web application",
# redirect URI <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id

# GitHub OAuth app (https://github.com/settings/developers),
# callback URL <NEXTAUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=your-github-client-id

# Cloudflare R2 bucket and its API token's access key ID
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_BUCKET_NAME=meme-pictures
R2_PUBLIC_URL=https://your-bucket-public-url

# Cloudflare Turnstile site key; leave empty to skip the captcha
TURNSTILE_SITE_KEY=

# Gemini model for image analysis
GOOGLE_AI_MODEL=gemini-3.5-flash-lite

# --- Secrets (in production: the memepix-app-secrets JSON in Secret Manager) ---

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret

GOOGLE_CLIENT_SECRET=your-google-client-secret

GITHUB_CLIENT_SECRET=your-github-client-secret

# Gemini API key (https://aistudio.google.com/app/apikey)
GOOGLE_AI_API_KEY=your-gemini-api-key

R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Leave empty to skip captcha verification
TURNSTILE_SECRET_KEY=

# Alternatively, set all six secrets as one JSON object, like production.
# When set, the six variables above are ignored.
# APP_SECRETS={"NEXTAUTH_SECRET":"...","GOOGLE_CLIENT_SECRET":"...","GITHUB_CLIENT_SECRET":"...","GOOGLE_AI_API_KEY":"...","R2_SECRET_ACCESS_KEY":"...","TURNSTILE_SECRET_KEY":"..."}
