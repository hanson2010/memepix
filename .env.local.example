# Non-sensitive settings (client IDs, key IDs, bucket, URLs) live in src/lib/env.ts.
# Any of them can be overridden here with a variable of the same name.

# Secrets: either one JSON blob (same shape as the memepix-secrets Secret Manager secret)...
# APP_SECRETS={"NEXTAUTH_SECRET":"...","GITHUB_CLIENT_SECRET":"...","GOOGLE_AI_API_KEY":"...","R2_SECRET_ACCESS_KEY":"...","TURNSTILE_SECRET_KEY":"..."}

# ...or individual variables
NEXTAUTH_SECRET=your-random-secret-key-here
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
GOOGLE_AI_API_KEY=your-gemini-api-key-here
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Google Cloud / Firestore
# For local dev, either set GOOGLE_APPLICATION_CREDENTIALS or run: gcloud auth application-default login
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
